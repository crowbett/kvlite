{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(task *)",
      "Bash(task *)",
      "PowerShell(go build *)",
      "Bash(go build *)",
      "PowerShell(go test *)",
      "Bash(go test *)",
      "PowerShell(go vet *)",
      "Bash(go vet *)",
      "PowerShell(go list *)",
      "Bash(go list *)",
      "PowerShell(go run ./cmd/*)",
      "Bash(go run ./cmd/*)",
      "PowerShell(go mod tidy)",
      "Bash(go mod tidy)",
      "PowerShell(go mod verify)",
      "Bash(go mod verify)",
      "PowerShell(golangci-lint run *)",
      "Bash(golangci-lint run *)",
      "PowerShell(golangci-lint fmt *)",
      "Bash(golangci-lint fmt *)",
      "PowerShell(govulncheck *)",
      "Bash(govulncheck *)",
      "PowerShell(goreleaser check *)",
      "Bash(goreleaser check *)",
      "PowerShell(goreleaser check)",
      "Bash(goreleaser check)",
      "PowerShell(goreleaser build --snapshot *)",
      "Bash(goreleaser build --snapshot *)"
    ]
  }
}
